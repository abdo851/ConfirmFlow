# Public configuration (safe for client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment
NODE_ENV=development

# Server-only secrets (required for M2-C3 Shopify DB persistence)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shopify OAuth (M2-B)
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
SHOPIFY_SESSION_SECRET=generate-a-random-secret-at-least-32-characters-long
SHOPIFY_OAUTH_SCOPES=read_products,read_orders

# YouCan OAuth (MVP primary store integration)
YOUCAN_API_KEY=your-youcan-api-key
YOUCAN_API_SECRET=your-youcan-api-secret
YOUCAN_SESSION_SECRET=generate-a-random-secret-at-least-32-characters-long
YOUCAN_OAUTH_SCOPES=read-orders,read-products

# Meta connection (M4-A) — server-only, never expose to client
META_SESSION_SECRET=generate-a-random-secret-at-least-32-characters-long

# WooCommerce Application Authentication — server-only, never expose to client
# Optional display name: WOOCOMMERCE_APP_NAME=Confirma
WOOCOMMERCE_SESSION_SECRET=

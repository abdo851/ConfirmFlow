# Public configuration (safe for client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment
NODE_ENV=development

# Server-only secrets (required for M2-C3 Shopify DB persistence)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shopify OAuth (M2-B)
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
SHOPIFY_SESSION_SECRET=generate-a-random-secret-at-least-32-characters-long
SHOPIFY_OAUTH_SCOPES=read_products
